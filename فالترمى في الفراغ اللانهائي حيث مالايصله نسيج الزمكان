-- وظيفة البحث عن اللاعب بالاسم الجزئي
local function findTarget(name)
    for _, ply in ipairs(Players:GetPlayers()) do
        if ply ~= LocalPlayer then
            if ply.Name:lower():sub(1, #name) == name:lower() or ply.DisplayName:lower():sub(1, #name) == name:lower() then
                return ply
            end
        end
    end
    return nil
end

-- تنفيذ الخطوة 1: الانتقال للهدف للكلبشة
BtnStep1.MouseButton1Click:Connect(function()
    local inputName = NameInput.Text
    if inputName == "" then
        BtnStep1.Text = "الرجاء كتابة اسم اللاعب أولاً!"
        task.wait(1.5)
        BtnStep1.Text = "1. انتقال للهدف (كلبشه سريعاً!)"
        return
    end

    targetPlayer = findTarget(inputName)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            -- [حفظ الإحداثيات الأولى]: تسجيل مكانك الحالي والآمن تماماً هنا قبل أي حركة أو انتقال للاعب
            originalPosition = myChar.HumanoidRootPart.CFrame
            
            -- الانتقال أمام الخصم مباشرة لتظهر دائرة الكلبشة
            myChar.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -2.5)
            BtnStep1.Text = "تم الانتقال! كلبشه الآن بسرعة 👇"
        end
    else
        BtnStep1.Text = "لم يتم العثور على اللاعب!"
        task.wait(1.5)
        BtnStep1.Text = "1. انتقال للهدف (كلبشه سريعاً!)"
    end
end)

-- تنفيذ الخطوة 2 المعدلة: إسقاط لمستوى آمن والعودة وترك الخصم يسقط وحده
BtnStep2.MouseButton1Click:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    if not originalPosition then
        BtnStep2.Text = "خطأ: لم يتم حفظ موقعك الأصلي!"
        task.wait(1.5)
        BtnStep2.Text = "2. إسقاط في الفويد والعودة 💀"
        return
    end

    -- [تعديل الارتفاع]: النزول إلى مستوى آمن ومتوسط (-140 فقط) حتى لا يتأثر حسابك بنظام الموت التلقائي
    local targetVoidCFrame = CFrame.new(myChar.HumanoidRootPart.Position.X, -140, myChar.HumanoidRootPart.Position.Z)
    
    -- حركة نزول تدريجية فائقة السرعة للحفاظ على الكلبشة حتى الوصول للموقع الأمن
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(myChar.HumanoidRootPart, tweenInfo, {CFrame = targetVoidCFrame})
    
    tween:Play()
    tween.Completed:Wait() -- انتظار انتهاء النزول السريع مع الخصم
    
    task.wait(0.15) -- مهلة ضئيلة ليتأكد السيرفر من النزول المشترك
    
    -- [تطبيق الخطة]: فك الكلبشة تلقائياً عبر نقل الأداة للحقيبة لترك الخصم يكمل هبوطه الحر وحده نحو الموت
    for _, tool in ipairs(myChar:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = LocalPlayer.Backpack
        end
    end
    
    -- تصفير السرعة والجاذبية المكتسبة لحسابك لحمايتك تماماً من الارتداد لأسفل
    myChar.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    
    -- [العودة الآمنة]: إعادتك الفورية الحية لموقعك الآمن المذكور بالسطر 157 قبل الانتقال للاعب
    myChar.HumanoidRootPart.CFrame = originalPosition
    
    -- تأكيد التثبيت لمنع أي تأخير في محاكاة السيرفر
    task.wait(0.05)
    myChar.HumanoidRootPart.CFrame = originalPosition
    
    -- إعادة تعيين المتغيرات للعملية القادمة
    originalPosition = nil
    BtnStep1.Text = "1. انتقال للهدف (كلبشه سريعاً!)"
    BtnStep2.Text = "تم تركه ليسقط بنجاح! 😉🔥"
    task.wait(2)
    BtnStep2.Text = "2. إسقاط في الفويد والعودة 💀"
end)
