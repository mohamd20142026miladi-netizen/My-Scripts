-- منطق ممر الفضاء الكوني المستقر
local Player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local IsActive = false
local CosmicConnection = nil

-- تحديد الألوان المستوحاة من الصورة 1000004426.jpg بدقة
local DeepSpaceColor = Color3.fromRGB(45, 10, 85) -- بنفسجي نيلي عميق (لون السماء)
local PlanetGlowColor = Color3.fromRGB(255, 100, 0) -- برتقالي ناري متوهج (لون الكوكب)

ToggleButton.MouseButton1Click:Connect(function()
    IsActive = not IsActive
    
    if IsActive then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- أخضر
        
        CosmicConnection = RunService.RenderStepped:Connect(function()
            local Character = Player.Character
            local Root = Character and Character:FindFirstChild("HumanoidRootPart")
            local Humanoid = Character and Character:FindFirstChild("Humanoid")
            
            if Root and Humanoid and Humanoid.MoveDirection.Magnitude > 0 then
                
                -- ضبط الارتفاع ليكون تحت القدم مباشرة للحفاظ على جرافيك المشي
                local BasePos = Root.Position + Vector3.new(0, -2.85, 0) + (Humanoid.MoveDirection * 0.4)
                
                -- 1. إنشاء البلاطة الزجاجية الشفافة بلون الفضاء النيلي العميق
                local CosmicGlass = Instance.new("Part")
                CosmicGlass.Size = Vector3.new(6, 0.2, 4)
                CosmicGlass.Material = Enum.Material.Glass
                CosmicGlass.Color = DeepSpaceColor
                CosmicGlass.Transparency = 0.4 -- شفافة لتندمج مع خلفية السماء
                CosmicGlass.Anchored = true
                CosmicGlass.CanCollide = true
                CosmicGlass.CFrame = CFrame.new(BasePos, BasePos + Root.CFrame.LookVector)
                CosmicGlass.Parent = workspace
                Debris:AddItem(CosmicGlass, 2.2)
                
                -- 2. جرافيك الإشعاع السفلي المتوهج بلون الكوكب الناري الخافت
                local PlanetGlow = Instance.new("Part")
                PlanetGlow.Size = Vector3.new(5.9, 0.05, 3.9)
                PlanetGlow.Material = Enum.Material.Neon
                PlanetGlow.Color = PlanetGlowColor
                PlanetGlow.Transparency = 0.82 -- خافت ليعطي لمعاناً سحرياً مذهلاً مثل توهج الكوكب
                PlanetGlow.Anchored = true
                PlanetGlow.CanCollide = false
                PlanetGlow.CFrame = CosmicGlass.CFrame * CFrame.new(0, -0.08, 0)
                PlanetGlow.Parent = workspace
                Debris:AddItem(PlanetGlow, 2.2)
            end
        end)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- أحمر
        if CosmicConnection then
            CosmicConnection:Disconnect()
            CosmicConnection = nil
        end
    end
end)

-- تصفير عند الموت
Player.CharacterAdded:Connect(function()
    IsActive = false
    ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    if CosmicConnection then CosmicConnection:Disconnect() end
end)
