-- Toggle GUI visibility
CircleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- Toggle Tracking Status (Red / Green)
ToggleBtn.MouseButton1Click:Connect(function()
    trackingActive = not trackingActive
    if trackingActive then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80) -- Green
        ToggleBtn.Text = "مُترقب (جاري الرصد)"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40) -- Red
        ToggleBtn.Text = "تجهيز"
        AlertFrame.Visible = false
    end
end)

-- Teleport Logic
local function teleportToDrop(targetPart)
    if targetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local cf = targetPart:IsA("Model") and targetPart:GetPivot() or targetPart.CFrame
        LocalPlayer.Character.HumanoidRootPart.CFrame = cf + Vector3.new(0, 5, 0)
    end
end

YesBtn.MouseButton1Click:Connect(function()
    AlertFrame.Visible = false
    if currentDropPart then
        teleportToDrop(currentDropPart)
    end
end)

-- Detector Function for Drops
local function checkObject(obj)
    if not trackingActive then return end
    local name = string.lower(obj.Name)
    if name:find("drop") or name:find("airdrop") or name:find("crate") or name:find("دروب") or name:find("صندوق") then
        currentDropPart = obj
        AlertFrame.Visible = true
    end
end

Workspace.DescendantAdded:Connect(checkObject)
