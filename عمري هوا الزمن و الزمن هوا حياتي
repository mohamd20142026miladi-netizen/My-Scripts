-- رصد الموت والانتقال الفوري
local function setupCharacterLogic(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    
    if humanoid and rootPart then
        -- أولاً: رصد لحظة الموت مباشرة لتسجيل الإحداثيات
        humanoid.Died:Connect(function()
            if isRewindActive then
                lastDeathPosition = rootPart.CFrame
            end
        end)
    end
end

-- تطبيق المنطق عند تحميل الشخصية وتجددها
if LocalPlayer.Character then
    setupCharacterLogic(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(character)
    setupCharacterLogic(character)
    -- عند إعادة إحياء اللاعب، نقله فوراً إلى مكان موته السابق إذا تم تفعيل الخاصية
    task.wait(0.1)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if isRewindActive and lastDeathPosition and rootPart then
        rootPart.CFrame = lastDeathPosition
    end
end)
