local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local camera = game.Workspace.CurrentCamera
local uis = game:GetService("UserInputService")

local voidHeight = Vector3.new(0, 10000, 0)
local originalCFrame = nil
local inVoid = false
local spyMode = false
local riftPart = nil
local voidFolder = nil
local spyCamPart = nil

-- تحديث الشخصية تلقائياً عند الموت والإعادة (Respawn)
player.CharacterAdded:Connect(function(newChar)
    char = newChar
    root = char:WaitForChild("HumanoidRootPart")
    
    -- إعادة تعيين الحالات وإزالة الفراغ القديم إن وجد
    inVoid = false
    spyMode = false
    if voidFolder then voidFolder:Destroy() end
    if spyCamPart then spyCamPart:Destroy() end
    if riftPart then riftPart:Destroy() end
end)

-- 1. UI Setup
